# FocusForge AI environment variables
# Local auth/site URLs for this project should use http://localhost:4029

# Required for Supabase auth, sessions, and database access
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional AI provider keys
# If OPENROUTER_API_KEY is omitted, the AI coach uses the built-in fallback response.
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional model override for OpenRouter
OPENROUTER_MODEL=openai/gpt-4o-mini
